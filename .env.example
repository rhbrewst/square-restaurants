# ─────────────────────────────────────────────
#  Square Restaurants — Environment Variables
#  Copy this file to .env and fill in your keys
#  NEVER commit .env to version control
# ─────────────────────────────────────────────

# Anthropic (Claude)
# Get from: https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=

# Twilio
# Get from: https://console.twilio.com → Dashboard
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The phone number you bought in Twilio (E.164 format, e.g. +12025551234)
TWILIO_PHONE_NUMBER=

# ElevenLabs
# API Key: https://elevenlabs.io → Profile → API Keys
# Agent ID: https://elevenlabs.io → Conversational AI → Agents → your agent → Settings
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# ngrok
# Get from: https://dashboard.ngrok.com → Your Authtoken
NGROK_AUTH_TOKEN=

# PostgreSQL
# Railway injects DATABASE_URL automatically when you add a Postgres service.
# For local dev: copy the connection string from Railway's Connect tab.
DATABASE_URL=

# Public URL (required for Twilio signature validation in production)
# Set to your Railway public domain, e.g. https://your-app.up.railway.app
# For local dev with ngrok, set to your current ngrok URL.
PUBLIC_URL=

# Restaurant contact number — included in SMS footers so guests can call back
RESTAURANT_PHONE=

# Server config
NODE_ENV=development
PORT=3000
